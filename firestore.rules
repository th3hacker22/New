rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /follows/{userId}/following/{targetUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /feedPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      // Secure update: 
      // - Author can update own post (but not inflate kudos beyond +1 logic handled by separate rule)
      // - Other users can ONLY increment kudosCount by exactly 1, cannot self-kudos
      allow update: if request.auth != null && (
        // Author full update (except malicious kudos self-bump > 1 is blocked by second clause)
        resource.data.authorUid == request.auth.uid ||
        (
          // Non-author kudos increment only
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudosCount']) &&
          request.resource.data.kudosCount == resource.data.kudosCount + 1 &&
          request.auth.uid != resource.data.authorUid &&
          request.resource.data.kudosCount >= 0 &&
          request.resource.data.kudosCount <= resource.data.kudosCount + 1000
        )
      );
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }
  }
}
